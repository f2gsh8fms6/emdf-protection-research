+// The container's secondary protection field is not filler: signing writes
+// the top bits of a second HMAC over the primary digest, and verification
+// checks them the same way it checks the primary.
+TEST_CASE("the secondary protection tag is written and checked", "[signing][emdf][verify]") {
+    const std::vector<std::byte> original = encode_atmos_stream(2, /*emit_objects=*/true);
+    REQUIRE_FALSE(original.empty());
+    const iclforge::base::crypto::SigningKey key = make_key(0x55);
+
+    std::vector<std::byte> signed_stream = original;
+    REQUIRE(iclforge::ac3::signing::sign_atmos_stream(signed_stream, key) == 2);
+    CHECK(iclforge::ac3::signing::verify_atmos_frame(signed_stream, key) ==
+          iclforge::ac3::signing::VerifyResult::kValid);
+
+    // The secondary field is the tail of the container's parsed content: the
+    // last protection_secondary_code-declared bits of it. This project's own
+    // writer declares 32 primary + 8 secondary, code 1.
+    const auto layout = iclforge::ac3::emdf::walk_frame(signed_stream);
+    REQUIRE(layout.supported);
+    REQUIRE(layout.has_container);
+    REQUIRE(layout.protection_secondary_code == 1);
+    const std::size_t sec_off = layout.container_start + layout.container_parsed_bits - 8;
+
+    const auto tampered = with_bit_flipped(signed_stream, sec_off);
+    CHECK(iclforge::ac3::signing::verify_atmos_frame(tampered, key) ==
+          iclforge::ac3::signing::VerifyResult::kMismatch);
+}
