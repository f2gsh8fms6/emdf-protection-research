+// A frame that carries the Annex E informational-metadata element signs and
+// verifies like any other in this shape, but the element itself, flag plus
+// body, is a hole (see the walker's hole test in test_emdf.cpp).
+TEST_CASE("signing covers frames that carry info metadata, minus the element itself",
+          "[signing][emdf]") {
+    const std::vector<std::byte> payload(6, std::byte{0x5A});
+    const std::array<iclforge::objects::emdf::Payload, 1> payloads{
+        {{.id = iclforge::objects::emdf::kPayloadIdOamd, .bytes = payload}}};
+    const auto container = iclforge::objects::emdf::build_container(payloads);
+    const auto frame = iclforge::ac3::eac3::build_silent_frame(
+        {.bitrate_kbps = 448,
+         .acmod = iclforge::ac3::Acmod::k3_2,
+         .lfe = true,
+         .info = iclforge::ac3::meta::BsiInfo{}},
+        container);
+    REQUIRE(frame.has_value());
+
+    const iclforge::base::crypto::SigningKey key = make_key(0x44);
+    std::vector<std::byte> signed_frame = *frame;
+    REQUIRE(iclforge::ac3::signing::sign_atmos_frame(signed_frame, key));
+    CHECK(iclforge::ac3::signing::verify_atmos_frame(signed_frame, key) ==
+          iclforge::ac3::signing::VerifyResult::kValid);
+
+    // Bit 56 is copyrightb, inside the excised element; bit 47 is a dialnorm
+    // bit, authenticated. Both flips keep the frame's layout intact, so each
+    // verdict is the tag's alone.
+    SECTION("a flipped info-metadata bit is not authenticated") {
+        CHECK(iclforge::ac3::signing::verify_atmos_frame(with_bit_flipped(signed_frame, 56), key) ==
+              iclforge::ac3::signing::VerifyResult::kValid);
+    }
+    SECTION("the same flip in authenticated bsi is") {
+        CHECK(iclforge::ac3::signing::verify_atmos_frame(with_bit_flipped(signed_frame, 47), key) ==
+              iclforge::ac3::signing::VerifyResult::kMismatch);
+    }
+}
